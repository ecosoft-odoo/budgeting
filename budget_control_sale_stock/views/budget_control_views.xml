<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="budget_control_view_form" model="ir.ui.view">
        <field name="name">budget.control.view.form</field>
        <field name="model">budget.control</field>
        <field name="inherit_id" ref="budget_control.budget_control_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='budget_control_left']" position="inside">
                <field name="project_id" invisible="not project_id" />
                <field name="sale_price" />
                <field name="gross_profit" />
                <field name="gross_profit_percent" string="Gross Profit %" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_sale_order"
                    type="object"
                    icon="fa-files-o"
                    invisible="sale_order_count == 0"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="sale_order_count" />
                        </span>
                        <span class="o_stat_text">Sale Order</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='allocated_amount']" position="attributes">
                <attribute
                    name="readonly"
                >state != 'draft' or budget_plan_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@id='action_confirm']" position="before">
                <button
                    name="action_create_budget_control"
                    type="object"
                    string="Create Budget"
                    invisible="not can_create_budget"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_budget_control"
                    type="object"
                    icon="fa-usd"
                    invisible="not budget_control_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Budget</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

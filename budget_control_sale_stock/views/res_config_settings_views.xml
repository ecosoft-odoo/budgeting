<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_budget" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.budget</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='budget_control_options_container']"
                position="inside"
            >
                <setting
                    id="budget_sale_analytic_plan"
                    help="Default analytic plan for auto-created analytic accounts from sale orders without project."
                >
                    <field name="budget_sale_analytic_plan_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

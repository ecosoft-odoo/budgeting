<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="budget_period_view_list" model="ir.ui.view">
        <field name="name">budget.period.view.list</field>
        <field name="model">budget.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="budget_scope" />
                <field name="bm_date_from" />
                <field name="bm_date_to" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>
    <record id="budget_period_view_form" model="ir.ui.view">
        <field name="name">budget.period.view.form</field>
        <field name="model">budget.period</field>
        <field name="arch" type="xml">
            <form string="Budget Period">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1>
                            <field name="name" placeholder="Name" />
                        </h1>
                    </div>
                    <group name="period">
                        <group name="period_left">
                            <field name="budget_scope" readonly="1" />
                        </group>
                        <group name="period_right">
                            <field name="bm_date_from" />
                            <field name="bm_date_to" />
                        </group>
                    </group>
                    <group name="companies">
                        <field
                            name="company_ids"
                            widget="many2many_tags"
                            groups="base.group_multi_company"
                            placeholder="All companies"
                        />
                    </group>
                    <!-- Budget applications add their settings as pages -->
                    <notebook name="settings" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="budget_period_view_search" model="ir.ui.view">
        <field name="name">budget.period.view.search</field>
        <field name="model">budget.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_ids" groups="base.group_multi_company" />
                <filter
                    name="fiscal"
                    string="Fiscal Periods"
                    domain="[('budget_scope', '=', 'fiscal')]"
                />
                <filter
                    name="lifetime"
                    string="Lifetime"
                    domain="[('budget_scope', '=', 'lifetime')]"
                />
                <filter
                    name="group_by_budget_scope"
                    string="Scope"
                    context="{'group_by': 'budget_scope'}"
                />
            </search>
        </field>
    </record>
    <record id="budget_period_action" model="ir.actions.act_window">
        <field name="name">Budget Periods</field>
        <field name="res_model">budget.period</field>
        <field name="view_mode">list,form</field>
        <field name="path">budget-period</field>
        <field name="view_id" ref="budget_period_view_list" />
    </record>
    <menuitem id="menu_budget" name="Budget" parent="base.menu_custom" sequence="1" />
    <menuitem
        id="menu_budget_period"
        name="Budget Periods"
        parent="menu_budget"
        action="budget_period_action"
    />
</odoo>

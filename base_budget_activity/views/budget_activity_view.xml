<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Budget Activity Keyword -->
    <record id="budget_activity_keyword_view_list" model="ir.ui.view">
        <field name="name">budget.activity.keyword.view.list</field>
        <field name="model">budget.activity.keyword</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="budget_activity_keyword_view_search" model="ir.ui.view">
        <field name="name">budget.activity.keyword.view.search</field>
        <field name="model">budget.activity.keyword</field>
        <field name="priority" eval="15" />
        <field name="arch" type="xml">
            <search string="Search Budget Activity Keywords">
                <field
                    name="name"
                    string="Keyword"
                    filter_domain="[('name', 'ilike', self)]"
                />
                <filter
                    name="active"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="groupby">
                    <filter
                        string="Company"
                        name="groupby_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="budget_activity_keyword_view_form" model="ir.ui.view">
        <field name="name">budget.activity.keyword.view.form</field>
        <field name="model">budget.activity.keyword</field>
        <field name="arch" type="xml">
            <form string="Budget Activity Keywords">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="budget_activity_keyword_action" model="ir.actions.act_window">
        <field name="name">Budget Activity Keywords</field>
        <field name="res_model">budget.activity.keyword</field>
        <field name="view_mode">list,form</field>
        <field name="path">budget-activity-keyword</field>
        <field name="view_id" ref="budget_activity_keyword_view_list" />
    </record>

    <!-- Budget Activity -->
    <record id="budget_activity_view_list" model="ir.ui.view">
        <field name="name">budget.activity.view.list</field>
        <field name="model">budget.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="keyword_ids" widget="many2many_tags" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>
    <record id="view_budget_activity_filter" model="ir.ui.view">
        <field name="name">view.budget.activity.filter</field>
        <field name="model">budget.activity</field>
        <field name="priority" eval="15" />
        <field name="arch" type="xml">
            <search string="Search Budget activity">
                <field name="name" string="Budget Activity" />
                <field name="keyword_ids" />
                <filter
                    name="active"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="groupby">
                    <filter
                        string="Company"
                        name="groupby_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="budget_activity_view_form" model="ir.ui.view">
        <field name="name">budget.activity.view.form</field>
        <field name="model">budget.activity</field>
        <field name="arch" type="xml">
            <form string="Budget activity Sheet">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title" name="title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group name="activity_left">
                            <field name="keyword_ids" widget="many2many_tags" />
                        </group>
                        <group name="activity_right">
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="budget_activity_action" model="ir.actions.act_window">
        <field name="name">Budget Activities</field>
        <field name="res_model">budget.activity</field>
        <field name="view_mode">list,form</field>
        <field name="path">budget-activity</field>
        <field name="view_id" ref="budget_activity_view_list" />
    </record>

    <menuitem
        id="menu_budget_activity"
        name="Budget Activities"
        parent="base_budget.menu_budget"
        action="budget_activity_action"
        sequence="20"
    />
    <menuitem
        id="menu_budget_activity_keyword"
        name="Budget Activity Keywords"
        parent="base_budget.menu_budget"
        action="budget_activity_keyword_action"
        sequence="30"
    />
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="budget_report_wizard_form" model="ir.ui.view">
        <field name="name">budget.report.wizard.form</field>
        <field name="model">budget.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="budget_period_id" />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <group>
                        <field name="report_type" readonly="1" />
                    </group>
                </group>
                <notebook>
                    <page string="Analytic">
                        <field
                            name="analytic_account_ids"
                            options="{'no_create': True}"
                        />
                    </page>
                </notebook>
                <footer>
                    <button
                        name="run_report_excel"
                        type="object"
                        string="Run"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_budget_report_excel" model="ir.actions.act_window">
        <field name="name">Budget Report (.xlsx)</field>
        <field name="res_model">budget.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'access_sudo': 1}</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="budget_excel_menu"
        parent="budget_control.budget_report_menu"
        name="Excel Report"
        sequence="70"
        groups="budget_control.group_budget_control_manager,budget_control_report.group_export_excel_budget"
    />

    <menuitem
        name="Budget Report (.xlsx)"
        action="action_budget_report_excel"
        id="menu_action_budget_report_excel"
        parent="budget_control_report.budget_excel_menu"
        groups="budget_control.group_budget_control_manager,budget_control_report.group_export_excel_budget"
        sequence="40"
    />
</odoo>

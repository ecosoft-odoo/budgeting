<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Date Range Types -->
    <record id="date_range_type_year_demo" model="date.range.type">
        <field name="name">Year (demo)</field>
        <field name="allow_overlap" eval="False" />
        <field name="duration_count" eval="1" />
        <field name="unit_of_time">0</field>
    </record>
    <record id="date_range_type_month_demo" model="date.range.type">
        <field name="name">Month (demo)</field>
        <field name="allow_overlap" eval="False" />
        <field name="duration_count" eval="1" />
        <field name="unit_of_time">1</field>
    </record>

    <!-- Monthly Date Ranges (Jan - Dec) for current year -->
    <record id="date_range_month_01_demo" model="date.range">
        <field name="name" eval="time.strftime('%Y/01')" />
        <field name="date_start" eval="time.strftime('%Y-01-01')" />
        <field name="date_end" eval="time.strftime('%Y-01-31')" />
        <field name="type_id" eval="ref('budget_control.date_range_type_month_demo')" />
    </record>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Budget Period for current year -->
    <record id="budget_period_demo" model="budget.period">
        <field name="name" eval="'FY%s (demo)' % time.strftime('%Y')" />
        <field name="template_id" eval="ref('budget_control.budget_template_demo')" />
        <field name="bm_date_from" eval="time.strftime('%Y-01-01')" />
        <field name="bm_date_to" eval="time.strftime('%Y-12-31')" />
        <field
            name="plan_date_range_type_id"
            eval="ref('budget_control.date_range_type_month_demo')"
        />
        <field name="control_level">analytic</field>
        <field name="control_budget" eval="True" />
    </record>
</odoo>

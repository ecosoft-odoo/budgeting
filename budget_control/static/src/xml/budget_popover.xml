<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="budget_control.popoverButton">
        <a
            tabindex="0"
            t-attf-class="p-1 fa #{ icon || 'fa-info-circle'} #{ color || 'text-primary'}"
        />
    </t>
    <div t-name="budget_control.popoverContent">
        <t t-esc="msg" />
    </div>
    <div t-name="budget_control.budgetPopOver">
        <p>
            <t t-esc="analytic" />
        </p>
        <table class="table table-borderless">
            <tbody>
                <tr>
                    <td>
                        Planned
                    </td>
                    <td class="text-right">
                        <t t-esc="budget" />
                    </td>
                </tr>
                <tr>
                    <td>
                        Used
                    </td>
                    <td class="text-right">
                        - <t t-esc="consumed" />
                    </td>
                </tr>
                <!-- <t t-raw="lead_days_description"/> -->
                <tr class="table-info">
                    <td>
                        Available
                    </td>
                    <td class="text-right text-nowrap">
                        = <t t-esc="balance" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</templates>

<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_budget_balance_forward_multi_company" model="ir.rule">
        <field name="name">Budget Balance Forward multi-company</field>
        <field name="model_id" ref="budget_control.model_budget_balance_forward" />
        <field eval="True" name="global" />
        <field name="domain_force">
        [
            '|',
            ('company_ids', '=', False),
            ('company_ids', 'in', company_ids)
        ]
        </field>
    </record>
    <record id="rule_budget_commit_forward_multi_company" model="ir.rule">
        <field name="name">Budget Commit Forward multi-company</field>
        <field name="model_id" ref="budget_control.model_budget_commit_forward" />
        <field eval="True" name="global" />
        <field name="domain_force">
        [
            '|',
            ('company_ids', '=', False),
            ('company_ids', 'in', company_ids)
        ]
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_purchase_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.stock.budget</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="budget_control.res_config_settings_view_form_budget"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='budget_control_options_container']"
                position="inside"
            >
                <setting
                    id="budget_inventory_actual_source"
                    string="Default Inventory Budget Actual Source"
                    help="Default for product categories set to Company Default. Changes apply to new transaction snapshots; finish open purchase and delivery flows before changing it. Services always use the vendor bill."
                >
                    <field name="budget_inventory_actual_source" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

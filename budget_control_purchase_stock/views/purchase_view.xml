<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_budget_stock" model="ir.ui.view">
        <field name="name">purchase.order.form.budget.stock</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="budget_control_purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='products']/field[@name='order_line']/list/field[@name='analytic_distribution']"
                position="after"
            >
                <field name="budget_actual_source" optional="hide" />
            </xpath>
            <xpath
                expr="//page[@name='budget_commit']/field[@name='budget_move_ids']/list/field[@name='move_id']"
                position="before"
            >
                <field name="stock_picking_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_category_form_budget_actual_source" model="ir.ui.view">
        <field name="name">product.category.form.budget.actual.source</field>
        <field name="model">product.category</field>
        <field
            name="inherit_id"
            ref="stock_account.view_category_property_form_stock"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_cost_method']" position="before">
                <field
                    name="budget_inventory_actual_source"
                    groups="budget_control.group_budget_control_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_budget_move_form" model="ir.ui.view">
        <field name="name">view.stock.budget.move.form</field>
        <field name="model">stock.budget.move</field>
        <field name="arch" type="xml">
            <form>
                <group name="reference" string="Reference">
                    <group name="group_left">
                        <field name="stock_move_id" />
                        <field name="picking_id" />
                    </group>
                    <group name="group_right">
                        <field name="reference" />
                        <field name="source_document" />
                    </group>
                </group>
                <group name="information" string="General Information">
                    <group name="group_left">
                        <field name="template_line_id" />
                        <field name="kpi_id" />
                        <field name="account_id" />
                        <field name="analytic_account_id" />
                        <field name="date" />
                        <field name="amount_currency" />
                        <field name="debit" />
                        <field name="credit" />
                    </group>
                    <group name="group_right">
                        <field name="company_id" />
                        <field name="product_id" />
                        <field name="note" />
                        <field name="adj_commit" />
                        <field name="fwd_commit" />
                    </group>
                </group>
                <group string="Stock Valuation Layers">
                    <field name="stock_valuation_layer_ids" nolabel="1" readonly="1" />
                </group>
            </form>
        </field>
    </record>
    <record id="view_stock_budget_move_list" model="ir.ui.view">
        <field name="name">view.stock.budget.move.list</field>
        <field name="model">stock.budget.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date" />
                <field name="picking_id" />
                <field name="stock_move_id" />
                <field name="product_id" />
                <field name="analytic_account_id" />
                <field name="kpi_id" />
                <field name="amount_currency" sum="Total" />
                <field name="debit" sum="Debit" />
                <field name="credit" sum="Credit" />
            </list>
        </field>
    </record>
</odoo>
